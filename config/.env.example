# MantisClaw Environment Variables
# NIEMALS committen! Kopiere diese Datei nach .env

# === AAMS Version (Single Source of Truth) ===
AAMS_VERSION=1.3.0

# === LOCAL BACKENDS (kein API-Key nötig) ===
# LM Studio: Starten, Modell laden, fertig.
# LM_STUDIO_URL=http://localhost:1234/v1

# Ollama: ollama serve, dann ollama pull <model>
# OLLAMA_URL=http://localhost:11434

# === CLOUD BACKENDS (optional) ===
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Nostr (MantisClaw)
NOSTR_PRIVATE_KEY=nsec1...

# Vector Store
CHROMA_PERSIST_DIR=./WORKING/AGENT-MEMORY
